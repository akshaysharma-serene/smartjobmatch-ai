APP_NAME=SmartJobMatch AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api
SECRET_KEY=smartjobmatch-ai-development-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./smartjobmatch.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartjobmatch

# Background Job Sync
SYNC_SCHEDULE_HOURS=6
ENABLE_SCHEDULED_SYNC=True

# External Integrations (Optional credentials)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_TOKEN=
OPENAI_API_KEY=
GREENHOUSE_BOARD_TOKEN=
LEVER_SITE_NAME=

# Default Preferences
DEFAULT_SEARCH_LOCATION=Bengaluru, Karnataka, India
DEFAULT_MIN_MATCH_SCORE=70.0

